{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "protibimbok/laramod",
    "description": "Explicit, convention-light modules for Laravel applications.",
    "keywords": ["laravel", "modules", "modular", "laramod"],
    "license": "MIT",
    "homepage": "https://github.com/protibimbok/laramod",
    "support": {
        "issues": "https://github.com/protibimbok/laramod/issues",
        "source": "https://github.com/protibimbok/laramod"
    },
    "type": "library",
    "authors": [
        {
            "name": "Saad",
            "email": "sakib.saad.khan@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "laravel/framework": "^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.27",
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "Laramod\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Laramod\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "@php vendor/bin/phpunit",
        "lint": "@php vendor/bin/pint"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Laramod\\LaramodServiceProvider"
            ],
            "aliases": {
                "Modules": "Laramod\\Facades\\Modules"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
